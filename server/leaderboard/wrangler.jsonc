{
  "name": "museum-mystery-leaderboard",
  "main": "worker.js",
  "compatibility_date": "2026-11-20",
  "vars": {
    "ALLOWED_ORIGINS": "https://florianstodden-afk.github.io,http://localhost:8000,http://127.0.0.1:8000",
    "APP_URL": "https://florianstodden-afk.github.io/Museum-Mystery/",
    "CALLBACK_URL": "REPLACE_WITH_WORKER_URL/auth/callback",
    "GITHUB_CLIENT_ID": "REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "museum-mystery-leaderboard",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
